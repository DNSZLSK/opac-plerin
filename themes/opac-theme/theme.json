{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1180px"
        },
        "color": {
            "custom": true,
            "customDuotone": false,
            "customGradient": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                { "slug": "ink", "color": "#1a1a1a", "name": "Texte" },
                { "slug": "muted", "color": "#6b6b6b", "name": "Texte secondaire" },
                { "slug": "bg", "color": "#faf9f6", "name": "Fond crème" },
                { "slug": "card", "color": "#ffffff", "name": "Card" },
                { "slug": "accent", "color": "#c0583a", "name": "Terracotta" },
                { "slug": "accent-light", "color": "#f3ebe7", "name": "Terracotta clair" },
                { "slug": "teal", "color": "#2a7a6e", "name": "Teal" },
                { "slug": "teal-light", "color": "#e4f0ee", "name": "Teal clair" },
                { "slug": "border", "color": "#e8e5e0", "name": "Bordure" },
                { "slug": "hero", "color": "#2c2926", "name": "Hero sombre" },
                { "slug": "amber-light", "color": "#fef4e6", "name": "Ambre clair" },
                { "slug": "amber", "color": "#9a6b1e", "name": "Ambre" }
            ]
        },
        "typography": {
            "customFontSize": true,
            "fluid": true,
            "lineHeight": true,
            "letterSpacing": true,
            "textTransform": true,
            "fontStyle": true,
            "fontWeight": true,
            "fontFamilies": [
                {
                    "slug": "display",
                    "name": "Playfair Display",
                    "fontFamily": "'Playfair Display', Georgia, 'Times New Roman', serif"
                },
                {
                    "slug": "body",
                    "name": "DM Sans",
                    "fontFamily": "'DM Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
                }
            ],
            "fontSizes": [
                { "slug": "x-small", "size": "11px", "name": "Très petit" },
                { "slug": "small", "size": "12px", "name": "Petit" },
                { "slug": "medium", "size": "14px", "name": "Moyen" },
                { "slug": "large", "size": "16px", "name": "Grand" },
                { "slug": "x-large", "size": "22px", "name": "Titre section" },
                { "slug": "xx-large", "size": "28px", "name": "Titre page" },
                { "slug": "huge", "size": "34px", "name": "Hero" }
            ]
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "em", "rem", "%", "vh", "vw"],
            "spacingScale": {
                "operator": "+",
                "increment": 0,
                "steps": 0
            },
            "spacingSizes": [
                { "slug": "10", "size": "8px", "name": "1" },
                { "slug": "20", "size": "16px", "name": "2" },
                { "slug": "30", "size": "24px", "name": "3" },
                { "slug": "40", "size": "32px", "name": "4" },
                { "slug": "50", "size": "40px", "name": "5" },
                { "slug": "60", "size": "56px", "name": "6" },
                { "slug": "70", "size": "72px", "name": "7" },
                { "slug": "80", "size": "96px", "name": "8" }
            ]
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "blocks": {
            "core/button": {
                "border": { "radius": true }
            }
        }
    },
    "styles": {
        "color": {
            "background": "var:preset|color|bg",
            "text": "var:preset|color|ink"
        },
        "typography": {
            "fontFamily": "var:preset|font-family|body",
            "fontSize": "var:preset|font-size|medium",
            "lineHeight": "1.6"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "var:preset|font-size|huge",
                    "fontWeight": "400",
                    "lineHeight": "1.25"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "var:preset|font-size|x-large",
                    "fontWeight": "400",
                    "lineHeight": "1.3"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "var:preset|font-size|large",
                    "fontWeight": "500",
                    "lineHeight": "1.35"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var:preset|font-family|body",
                    "fontSize": "var:preset|font-size|medium",
                    "fontWeight": "500",
                    "lineHeight": "1.4"
                }
            },
            "link": {
                "color": { "text": "var:preset|color|accent" },
                "typography": { "textDecoration": "none" },
                ":hover": {
                    "typography": { "textDecoration": "underline" }
                }
            },
            "button": {
                "color": {
                    "background": "var:preset|color|accent",
                    "text": "#ffffff"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|body",
                    "fontSize": "var:preset|font-size|small",
                    "fontWeight": "500"
                },
                "spacing": {
                    "padding": {
                        "top": "10px",
                        "right": "22px",
                        "bottom": "10px",
                        "left": "22px"
                    }
                },
                "border": { "radius": "6px" }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "var:preset|font-size|large",
                    "fontWeight": "500"
                }
            }
        }
    },
    "templateParts": [
        { "name": "header", "title": "En-tête", "area": "header" },
        { "name": "footer", "title": "Pied de page", "area": "footer" }
    ],
    "customTemplates": []
}
